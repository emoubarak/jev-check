# Copy to a gitignored file (e.g. .env.jevcheck in your project), point [run] env_file at it,
# or export these in your shell. Never commit real values.

# jev's decision model (https://docs.typesafe.ai). Required.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Writes the value of a field the agent decides to fill (a search box, a form). Optional:
# click-only goals never need it. Any OpenAI-compatible endpoint works.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Only if your browser is not found on PATH.
# BH_CHROME_PATH=/path/to/chrome
